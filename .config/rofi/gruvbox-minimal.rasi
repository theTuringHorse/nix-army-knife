* {
    bg:     #282828;
    bg-alt: #3c3836;
    fg:     #ebdbb2;
    fg-dim: #a89984;
    accent: #d79921;

    background-color: transparent;
    text-color:       @fg;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    width:            500px;
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    8px;
}

mainbox {
    padding:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    padding:          8px 12px;
    spacing:          8px;
    background-color: @bg-alt;
    border-radius:    6px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @fg-dim;
}

listview {
    lines:      8;
    columns:    1;
    fixed-height: true;
    scrollbar:  false;
    margin:     8px 0 0 0;
}

element {
    padding:       6px 12px;
    spacing:       10px;
    border-radius: 6px;
}

element selected {
    background-color: @bg-alt;
    text-color:       @accent;
}

element-icon {
    size: 20px;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}
